{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yield",
  "version": "0.8.0",
  "identifier": "com.yagoramires.yield",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yield",
        "width": 1200,
        "height": 780,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGOTAzQjJGOEVGQjYyQjUKUldTMVl2dU9MenVRRHpxakJialBMb3dYOGFwSE9lTG44N1UxYVo0Y2NoUXgxNFFxT1l5NFltRjYK",
      "endpoints": [
        "https://github.com/yagoramires/yield/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
